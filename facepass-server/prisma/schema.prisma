generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  name        String
  rollNumber  String   @unique
  email       String   @unique
  department  String?
  year        Int?
  verified    Boolean  @default(false)

  createdAt   DateTime @default(now())
}

model VerificationCode {
  id         String   @id @default(uuid())
  email      String
  otp        String
  expiresAt  DateTime
}